#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${SCRIPT_DIR}/../docker-compose.yml"
if docker info >/dev/null 2>&1; then
  DOCKER=(docker)
else
  DOCKER=(sudo docker)
fi
REFRESH="2.0"
if (( $# > 0 )) && [[ "${1}" != -* ]]; then
  REFRESH="$1"
  shift
elif (( $# >= 2 )) && [[ "${1}" == "--refresh" ]]; then
  REFRESH="$2"
  shift 2
fi

exec "${DOCKER[@]}" compose -f "${COMPOSE_FILE}" exec paper-engine \
  python -m paper_bot.cli watch --db /data/paper.db --refresh "${REFRESH}" "$@"
