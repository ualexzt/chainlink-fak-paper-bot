#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${SCRIPT_DIR}/../docker-compose.yml"
if docker info >/dev/null 2>&1; then
  DOCKER=(docker)
else
  DOCKER=(sudo docker)
fi
REFRESH="${1:-1.0}"
if (( $# > 0 )); then
  shift
fi

exec "${DOCKER[@]}" compose -f "${COMPOSE_FILE}" exec paper-engine \
  python -m paper_bot.cli watch --db /data/paper.db --refresh "${REFRESH}" "$@"
